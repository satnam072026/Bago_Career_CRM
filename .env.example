# ============================================================================
# SANDEEP WORKSPACE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env and supply real values. NEVER commit .env or live tokens.
# ============================================================================

NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_DISPLAY_TIMEZONE="Europe/Nicosia"

# PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://sandeep_workspace:change_me_local_pw@localhost:5432/sandeep_workspace?schema=public"

# Redis (BullMQ Background Discovery & Sync Worker)
REDIS_URL="redis://localhost:6379"

# Auth.js & Token Vault Encryption (32-byte base64 key for AES-256-GCM at-rest token encryption)
AUTH_SECRET="replace_with_openssl_rand_base64_32"
TOKEN_ENCRYPTION_KEY_BASE64="replace_with_openssl_rand_base64_32"

# Google OAuth 2.0 (Google Drive API v3 + Google Sheets API v4)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Microsoft Entra ID / Graph API (OneDrive + SharePoint Excel)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/callback/microsoft-entra-id"
